:8088 {
  encode zstd gzip
  handle /extensions/ledger/* {
    reverse_proxy ledger-ui:80
  }
  handle /extensions/ostris/* {
    reverse_proxy ostris-ui:80
  }
  handle /api/ledger/* {
    reverse_proxy ledger:8094
  }
  handle /api/ostris/* {
    reverse_proxy ostris:8095
  }
  handle {
    reverse_proxy shell:8080
  }
}
